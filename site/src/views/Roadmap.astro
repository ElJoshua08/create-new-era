---
import Base from '../layouts/Base.astro';
import { REPO, FALLBACK, routes, ui, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const soon = ui[lang].soon;

const copy = {
  en: {
    title: 'What’s next',
    description: 'What is coming to Create: New Era next: wireless towers, the Flows panel, focus mode, the spool winder and a survival progression.',
    lede: 'The pre-release already has the computer, the data bus, screens your programs draw on and a control desk they read. Here’s what’s being built next. None of this is in the current download yet.',
    nextTitle: 'Next up',
    next: [
      ['bus_port', 'Wireless towers and antennas', 'Reach machines across the map without running a cable all the way there.'],
      ['brass_computer', 'The Flows panel', 'A side panel in the editor that shows the data moving between your machines and your program as it happens. The panel is there today, still empty.'],
      ['port_hub', 'Focus mode', 'A placement mode for putting ports exactly where you want them on crowded machines.'],
      ['cable_spool', 'The spool winder', 'A machine that winds cable onto spools, so cabling has its own place in survival. For now a spool comes full from its recipe and can’t be refilled.'],
      ['control_plate', 'Survival recipes', 'Recipes that fit a survival progression. Some of the current ones are placeholders.'],
    ],
    laterTitle: 'Further out',
    later: [
      ['universal_adapter', 'Universal Adapter', 'A block that puts whatever it touches on the bus. It’s in the creative tab already, but doesn’t do anything yet.'],
      ['bearing_servo', 'Bearing Servo', 'Turns a contraption to an exact angle on command, for gimbals, turrets and flaps. Also placed but not working yet.'],
      ['control_plate', 'Visual programming', 'Programs built from nodes, for people who would rather not write Lua.'],
    ],
    shippedTitle: `Already in ${FALLBACK.tag}`,
    shipped: 'Brass Computer and editor · Lua with redstone · data ports, port hubs and cables · drivers for Create’s and Minecraft’s blocks · Brass Screens programs draw on · panel controls programs read and drive · panel speaker · chat log and Linked Typewriter · flight controls and instruments for Aeronautics ships · Ponder scenes',
    follow: 'Follow along on GitHub',
    download: 'Get the pre-release',
  },
  es: {
    title: 'Lo que viene',
    description: 'Lo que llega a Create: New Era: torres inalámbricas, el panel de flujos, el modo enfoque, la bobinadora y una progresión de supervivencia.',
    lede: 'El prelanzamiento ya trae el ordenador, el bus de datos, pantallas en las que dibujan tus programas y un pupitre de control que leen. Esto es lo que se está haciendo ahora. Nada de esto está todavía en la descarga actual.',
    nextTitle: 'Lo siguiente',
    next: [
      ['bus_port', 'Torres y antenas inalámbricas', 'Llega a máquinas al otro lado del mapa sin tender un cable hasta allí.'],
      ['brass_computer', 'El panel de flujos', 'Un panel lateral en el editor que enseña los datos que van y vienen entre tus máquinas y tu programa, en el momento. El panel ya está, pero vacío.'],
      ['port_hub', 'Modo enfoque', 'Un modo de colocación para poner los puertos justo donde quieres en máquinas con poco sitio.'],
      ['cable_spool', 'La bobinadora', 'Una máquina que enrolla cable en bobinas, para que el cableado tenga su sitio en supervivencia. De momento la bobina sale llena de su receta y no se puede rellenar.'],
      ['control_plate', 'Recetas de supervivencia', 'Recetas que encajen en una progresión de supervivencia. Algunas de las actuales son provisionales.'],
    ],
    laterTitle: 'Más adelante',
    later: [
      ['universal_adapter', 'Adaptador universal', 'Un bloque que pone en el bus lo que toque. Ya está en la pestaña de creativo, pero todavía no hace nada.'],
      ['bearing_servo', 'Servo de rodamiento', 'Gira un artefacto hasta un ángulo exacto cuando se lo pides, para cardanes, torretas y alerones. También se puede colocar, pero aún no funciona.'],
      ['control_plate', 'Programación visual', 'Programas hechos con nodos, para quien prefiera no escribir Lua.'],
    ],
    shippedTitle: `Ya en la ${FALLBACK.tag}`,
    shipped: 'Ordenador de latón y editor · Lua con redstone · puertos de datos, hubs de puertos y cables · drivers para los bloques de Create y de Minecraft · pantallas de latón en las que dibujan los programas · controles de panel que los programas leen y manejan · altavoz de panel · chat log y Linked Typewriter · mandos e instrumentos de vuelo para naves de Aeronautics · escenas de Ponder',
    follow: 'Síguelo en GitHub',
    download: 'Descarga el prelanzamiento',
  },
}[lang];
---

<Base lang={lang} page="roadmap" title={copy.title} description={copy.description}>
  <header class="page-head wrap">
    <h1>{copy.title}</h1>
    <p class="lede">{copy.lede}</p>
  </header>

  <section class="section--tight">
    <div class="wrap">
      <h2 class="track__title">{copy.nextTitle}</h2>
      <ol class="track">
        {
          copy.next.map(([icon, h, t]) => (
            <li>
              <img src={`/img/items/create_new_era_${icon}.png`} alt="" width="56" height="56" loading="lazy" />
              <div>
                <h3>
                  {h} <span class="soon">{soon}</span>
                </h3>
                <p>{t}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section--tight later">
    <div class="wrap">
      <h2 class="track__title">{copy.laterTitle}</h2>
      <ol class="track track--later">
        {
          copy.later.map(([icon, h, t]) => (
            <li>
              <img src={`/img/items/create_new_era_${icon}.png`} alt="" width="56" height="56" loading="lazy" />
              <div>
                <h3>{h}</h3>
                <p>{t}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap shipped">
      <div class="window">
        <div class="window__bar">{copy.shippedTitle}</div>
        <p class="window__body shipped__body">{copy.shipped}</p>
      </div>
      <div class="links">
        <a class="more" href={routes.download[lang]}>{copy.download}</a>
        <a class="more" href={REPO}>{copy.follow}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .track__title {
    margin-bottom: 2rem;
  }
  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: grid;
    gap: 0;
  }
  .track::before {
    content: '';
    position: absolute;
    left: 27px;
    top: 28px;
    bottom: 28px;
    width: 3px;
    background: repeating-linear-gradient(var(--brass-lo) 0 6px, transparent 6px 12px);
  }
  .track li {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 40rem);
    gap: 1.5rem;
    align-items: start;
    padding: 1.2rem 0;
  }
  .track img {
    image-rendering: pixelated;
    width: 56px;
    height: 56px;
    background: var(--ground);
    box-shadow: 0 0 0 8px var(--ground);
  }
  .later .track img {
    background: var(--ground-2);
    box-shadow: 0 0 0 8px var(--ground-2);
  }
  .track h3 {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    align-items: center;
    font-size: 1.25rem;
    padding-top: 0.6rem;
  }
  .track .soon {
    vertical-align: 0;
  }
  .track p {
    margin-top: 0.45rem;
    color: var(--ink-2);
  }
  .later {
    background: var(--ground-2);
  }
  .track--later h3 {
    color: var(--ink-2);
  }
  .shipped .window {
    max-width: 52rem;
  }
  .shipped__body {
    padding: 1.1rem 1.3rem;
    color: #e9e2d4;
    margin: 0;
    line-height: 1.7;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2.5rem;
    margin-top: 1rem;
  }
</style>
