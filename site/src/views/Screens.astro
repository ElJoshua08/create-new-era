---
import Base from '../layouts/Base.astro';
import SceneStage from '../components/SceneStage.astro';
import { routes, DOCS, type Lang } from '../i18n/routes';
import { highlight } from '../scripts/lua';

const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/** Screen markup to HTML spans: tags as keywords, attribute values as strings. */
const xml = (src: string) =>
  esc(src).replace(/(&lt;\/?)([a-z]+)([^&]*?)(\/?&gt;)/g, (_, open, tag, attrs, close) =>
    `${open}<span class="k">${tag}</span>${attrs.replace(/("[^"]*")/g, '<span class="s">$1</span>')}${close}`);

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const markup = `<screen>
  <title>IRON FARM</title>
  <row>
    <label>IRON</label>
    <value id="iron" align="right">0</value>
  </row>
  <bar id="load" value="0"/>
  <row>
    <button id="start">START</button>
    <button id="stop">STOP</button>
  </row>
</screen>`;

const program = {
  en: `local screen = bus.get("brass_screen")
local chest = bus.get("chest")

screen.show("farm")
screen.onClick("start", function(player)
  print(player .. " pressed START")
end)

while true do
  local iron = chest.count("minecraft:iron_ingot")
  screen.set("iron", iron)
  screen.set("load", iron / 1728)
  sleep(1)
end`,
  es: `local screen = bus.get("brass_screen")
local chest = bus.get("chest")

screen.show("farm")
screen.onClick("start", function(player)
  print(player .. " ha pulsado START")
end)

while true do
  local iron = chest.count("minecraft:iron_ingot")
  screen.set("iron", iron)
  screen.set("load", iron / 1728)
  sleep(1)
end`,
}[lang];

const copy = {
  en: {
    title: 'Screens and panels',
    description: 'Brass Screens that join into one big flip-dot display your programs draw on, and panel controls for building a control desk in a Create factory.',
    lede: 'Brass Screens that join into one big flip-dot display, and small controls for building a desk to run the factory from. Your programs draw on the screens, read the controls and drive the lamps, nixies and gauges.',
    screens: {
      title: 'One pane, however big',
      text: [
        'Screens facing the same way join up and the brass frame between them disappears, so any rectangle of them, up to 8 by 8, reads as a single display. Turn one with a wrench and it joins whatever it now lines up with.',
        'Each block adds 32 dots each way, made of physical flip dots that turn over when they change, in a ripple across the pane. A 2 by 2 pane is 56 by 56 dots.',
      ],
      apart: 'Apart',
      joined: 'Joined',
      draw: 'Draw on the dots with your mouse or finger. In the game, programs draw and players touch.',
      clear: 'Clear',
      alt: 'A wall of twelve Brass Screens, four wide and three high, joined into one pane.',
    },
    program: {
      title: 'A dashboard in a few lines',
      text: [
        'Lay a screen out in a .screen file: a title, rows of labels and values, bars and buttons. The screen arranges them and keeps the look, so there is no styling to write.',
        'The program shows the file once, then changes the parts that have an id. Only the dots that change turn over. Save the file and every screen showing it updates at once, without restarting anything.',
        'For anything else, draw it yourself: dots, lines, rectangles, circles and text in Monocraft, in 18 colours, and hear where players touch.',
      ],
      file: 'farm.screen',
      lua: 'startup.lua',
      docs: 'Screen markup in the docs',
    },
    panels: {
      title: 'Build a control desk',
      text: 'Each control is a control plate with one part on it, and it sits on floors, walls or ceilings. Cable straight into the plate and the control is on the bus: players press and turn it, programs read it and drive it.',
      alt: 'A control desk on andesite and brass casings with every panel control on it.',
      items: [
        ['panel_button', 'Button', 'A push button. Programs hear every press.'],
        ['panel_switch', 'Switch', 'An on/off lever that players and programs can both flip.'],
        ['panel_knob', 'Knob', 'Dials in a value. Programs give it its own range and step.'],
        ['panel_slider', 'Slider', 'A fader, with notches where its range says.'],
        ['panel_lamp', 'Lamp', 'A light in three colours that glows like a torch.'],
        ['nixie_digit', 'Nixie tube', 'Glows any character. Rows of up to 64 work as one display.'],
        ['panel_gauge', 'Gauge', 'A needle a program points at a value.'],
        ['panel_keypad', 'Keypad', 'For typing numbers into a program.'],
        ['panel_speaker', 'Speaker', 'Plays sounds and notes, and reads text aloud.'],
      ],
      docs: 'Every control in the docs',
    },
    next: 'What’s still to come',
  },
  es: {
    title: 'Pantallas y paneles',
    description: 'Pantallas de latón que se juntan en una gran pantalla de puntos giratorios en la que dibujan tus programas, y controles de panel para montar pupitres de control en tu fábrica de Create.',
    lede: 'Pantallas de latón que se juntan en una sola pantalla grande de puntos giratorios y pequeños controles para montar un pupitre desde el que manejar la fábrica. Tus programas dibujan en las pantallas, leen los controles y manejan pilotos, nixies e indicadores.',
    screens: {
      title: 'Un solo panel, del tamaño que quieras',
      text: [
        'Las pantallas que miran al mismo lado se juntan y el marco de latón entre ellas desaparece, así que cualquier rectángulo de pantallas, hasta 8 por 8, se ve como una sola. Gira una con la llave inglesa y se unirá a las que queden alineadas con ella.',
        'Cada bloque suma 32 puntos en cada sentido, puntos físicos que se dan la vuelta al cambiar, en una onda que recorre el panel. Un panel de 2 por 2 tiene 56 por 56 puntos.',
      ],
      apart: 'Separadas',
      joined: 'Juntas',
      draw: 'Dibuja en los puntos con el ratón o con el dedo. En el juego dibujan los programas y tocan los jugadores.',
      clear: 'Borrar',
      alt: 'Una pared de doce pantallas de latón, cuatro de ancho y tres de alto, unidas en un solo panel.',
    },
    program: {
      title: 'Un cuadro de mando en pocas líneas',
      text: [
        'Describe la pantalla en un archivo .screen: un título, filas de etiquetas y valores, barras y botones. La pantalla los coloca y se encarga del aspecto, así que no hay estilos que escribir.',
        'El programa muestra el archivo una vez y luego cambia las partes que tienen id. Solo giran los puntos que cambian. Guarda el archivo y todas las pantallas que lo muestran se actualizan al momento, sin reiniciar nada.',
        'Para todo lo demás, dibújalo tú: puntos, líneas, rectángulos, círculos y texto en Monocraft, en 18 colores, y entérate de dónde tocan los jugadores.',
      ],
      file: 'farm.screen',
      lua: 'startup.lua',
      docs: 'El marcado de pantallas en los docs',
    },
    panels: {
      title: 'Monta un pupitre de control',
      text: 'Cada control es una placa de control con una pieza encima, y va en suelos, paredes o techos. Lleva un cable directamente a la placa y el control queda en el bus: los jugadores lo pulsan y lo giran, y los programas lo leen y lo manejan.',
      alt: 'Un pupitre de control sobre revestimientos de andesita y latón con todos los controles de panel.',
      items: [
        ['panel_button', 'Pulsador', 'Un botón. Los programas se enteran de cada pulsación.'],
        ['panel_switch', 'Interruptor', 'Una palanca que pueden mover tanto los jugadores como los programas.'],
        ['panel_knob', 'Mando giratorio', 'Ajusta un valor. Los programas le dan su propio rango y paso.'],
        ['panel_slider', 'Deslizador', 'Un fader con muescas donde diga su rango.'],
        ['panel_lamp', 'Piloto', 'Una luz de tres colores que brilla como una antorcha.'],
        ['nixie_digit', 'Tubo nixie', 'Enciende cualquier carácter. Filas de hasta 64 funcionan como una sola pantalla.'],
        ['panel_gauge', 'Indicador de aguja', 'Una aguja que un programa apunta a un valor.'],
        ['panel_keypad', 'Teclado', 'Para meter números en un programa.'],
        ['panel_speaker', 'Altavoz', 'Reproduce sonidos y notas, y lee texto en voz alta.'],
      ],
      docs: 'Todos los controles en los docs',
    },
    next: 'Lo que falta por llegar',
  },
}[lang];
const s = copy.screens;
---

<Base lang={lang} page="screens" title={copy.title} description={copy.description}>
  <header class="page-head wrap">
    <h1>{copy.title}</h1>
    <p class="lede">{copy.lede}</p>
  </header>

  <section class="section--tight">
    <div class="wrap split split--flip">
      <div>
        <h2>{s.title}</h2>
        <div class="prose sp">
          {s.text.map((t) => <p>{t}</p>)}
        </div>
      </div>
      <SceneStage scene="wall" alt={s.alt} demo="wall" class="wall">
        <div class="wall__controls">
          <div class="seg" role="group">
            <button type="button" data-join="off" aria-pressed="false">{s.apart}</button>
            <button type="button" data-join="on" aria-pressed="true">{s.joined}</button>
          </div>
          <button type="button" class="btn wall__clear" data-clear>{s.clear}</button>
        </div>
        <p class="wall__hint">{s.draw}</p>
      </SceneStage>
    </div>
  </section>

  <section class="section--tight program">
    <div class="wrap split">
      <div>
        <h2>{copy.program.title}</h2>
        <div class="prose sp">
          {copy.program.text.map((t) => <p>{t}</p>)}
        </div>
        <a class="more" href={`${DOCS}/${lang}/guide/screen-markup/`}>{copy.program.docs}</a>
      </div>
      <div class="files">
        <div class="window">
          <div class="window__bar">{copy.program.file}</div>
          <pre class="codeblock"><code set:html={xml(markup)} /></pre>
        </div>
        <div class="window">
          <div class="window__bar">{copy.program.lua}</div>
          <pre class="codeblock"><code set:html={highlight(program)} /></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="section panels">
    <div class="wrap">
      <div class="split">
        <div>
          <h2>{copy.panels.title}</h2>
          <p class="prose sp">{copy.panels.text}</p>
        </div>
        <SceneStage scene="desk" alt={copy.panels.alt} />
      </div>
      <ul class="controls">
        {
          copy.panels.items.map(([id, name, text]) => (
            <li>
              <img src={`/img/items/create_new_era_${id}.png`} alt="" width="48" height="48" loading="lazy" />
              <div>
                <h3>{name}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="panels__links">
        <a class="more" href={`${DOCS}/${lang}/guide/screens-panels/`}>{copy.panels.docs}</a>
        <a class="more" href={routes.roadmap[lang]}>{copy.next}</a>
      </p>
    </div>
  </section>

</Base>

<script>
  import '../scripts/demos';
</script>

<style>
  .sp {
    margin-top: 1.2rem;
  }
  .sp p + p {
    margin-top: 1em;
  }
  .wall :global(.stage) {
    max-width: 560px;
    margin-inline: auto;
  }
  .wall__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 1.2rem;
    flex-wrap: wrap;
  }
  .seg {
    display: inline-flex;
    padding: 4px;
    background: #000;
    gap: 4px;
  }
  .seg button {
    font: 400 0.82rem/1 var(--display);
    padding: 0.75em 1em 0.7em;
    border: 0;
    cursor: pointer;
    background: #3a3a3a;
    color: #cfcfcf;
    box-shadow: inset -3px -3px 0 #222, inset 3px 3px 0 #555;
    transition: transform 90ms var(--ease-out);
  }
  .seg button:active {
    transform: translateY(2px);
  }
  .seg button[aria-pressed='true'] {
    background: var(--brass);
    color: var(--brass-text);
    box-shadow: inset -3px -3px 0 var(--brass-deep), inset 3px 3px 0 var(--brass-hi);
  }
  .wall__clear {
    font-size: 0.82rem;
    padding: 0.75em 1em 0.7em;
  }
  :global([data-apart]) .wall__clear,
  :global([data-apart]) .wall__hint {
    opacity: 0.35;
    pointer-events: none;
  }
  .wall__hint {
    margin-top: 1rem;
    text-align: center;
    color: var(--ink-3);
    font-size: 0.98rem;
    transition: opacity 200ms;
  }
  .panels {
    background: var(--ground-2);
  }
  .files {
    display: grid;
    gap: 1.2rem;
    min-width: 0;
  }
  .files .codeblock {
    font-size: 0.8rem;
  }
  .program .more {
    display: inline-block;
    margin-top: 1.4rem;
  }
  .panels__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-top: 2.2rem;
  }
  .panels__soon {
    margin-top: 1.2rem;
    color: var(--ink-3);
    font-size: 1rem;
  }
  .controls {
    list-style: none;
    padding: 0;
    margin: clamp(32px, 5vw, 64px) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem 2rem;
  }
  .controls li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 0.9rem;
    align-items: start;
  }
  .controls img {
    image-rendering: pixelated;
    width: 48px;
    height: 48px;
  }
  .controls p {
    margin-top: 0.3rem;
    color: var(--ink-2);
    font-size: 1rem;
  }
  .next {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem 3rem;
  }
  .next h3 {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    align-items: center;
  }
  .next .soon {
    vertical-align: 0;
  }
  .next p {
    margin-top: 0.4rem;
    color: var(--ink-2);
  }
  @media (max-width: 1000px) {
    .controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .controls,
    .next {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
