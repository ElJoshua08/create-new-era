---
import fs from 'node:fs';
import DownloadButton from './DownloadButton.astro';
import { routes, type Lang } from '../i18n/routes';

interface Chapter {
  title: string;
  text: string;
  soon?: boolean;
}
interface Props {
  lang: Lang;
  title: string;
  lede: string;
  needs: string;
  more: string;
  alt: string;
  chapters: Chapter[];
  editor: { title: string; run: string; stop: string; console: string; files: string };
  config: Record<string, unknown>;
  soon: string;
}
const p = Astro.props;
const meta = JSON.parse(fs.readFileSync(new URL('../../public/scenes/hero/scene.json', import.meta.url), 'utf8'));
const suggest = (p.config.suggest as string[]) ?? [];
---

<section class="hero" data-hero>
  <div class="hero__in wrap">
    <div class="hero__copy">
      <h1>{p.title}</h1>
      <p class="lede">{p.lede}</p>
      <div class="hero__cta">
        <DownloadButton lang={p.lang} note={p.needs} />
      </div>
    </div>

      <div class="stage hero__stage" style={`aspect-ratio:${meta.width}/${meta.height}`}>
        <img
          data-hero-still
          src="/scenes/hero/base.png"
          width={meta.width}
          height={meta.height}
          alt={p.alt}
          fetchpriority="high"
        />
        <canvas data-hero-canvas hidden aria-hidden="true"></canvas>
      </div>

      <div class="window editor" aria-hidden="true">
        <div class="window__bar editor__bar">
          <img src="/img/items/create_new_era_brass_computer.png" alt="" width="16" height="16" />
          <span>{p.editor.title}</span>
          <span class="editor__file">main.lua</span>
        </div>
        <div class="editor__body">
          <div class="editor__tools">
            <span class="ebtn ebtn--run" data-run>&#9654; {p.editor.run}</span>
            <span class="ebtn">&#9632; {p.editor.stop}</span>
          </div>
          <div class="editor__code">
            <pre class="editor__gutter" data-gutter></pre>
            <pre class="editor__text"><code data-code></code></pre>
            <ul class="suggest" data-suggest hidden>
              {suggest.map((s) => <li>{s}</li>)}
            </ul>
          </div>
          <div class="editor__console">
            <span class="editor__label">{p.editor.console}</span>
            <div data-console></div>
          </div>
        </div>
      </div>

      <div class="chapters">
        <button class="play" type="button" data-play aria-pressed="false">
          <svg class="i-pause" viewBox="0 0 10 10" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M2 1h2v8H2zM6 1h2v8H6z"></path></svg>
          <svg class="i-play" viewBox="0 0 10 10" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M2 1h1v8H2zM3 2h1v6H3zM4 3h2v4H4zM6 4h2v2H6z"></path></svg>
        </button>
        <ol>
          {
            p.chapters.map((c, i) => (
              <li>
                <button type="button" data-chapter={i}>
                  <span class="chapters__bar"><span /></span>
                  <span class="chapters__title">
                    {c.title}
                    {c.soon && <span class="soon">{p.soon}</span>}
                  </span>
                  <span class="chapters__text">{c.text}</span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
  <script type="application/json" data-hero-config set:html={JSON.stringify(p.config)} />
</section>

<script>
  import '../scripts/hero';
</script>

<style>
  .hero {
    padding-block: clamp(16px, 2.5vw, 32px) clamp(48px, 7vw, 96px);
  }
  .hero__in {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.4fr);
    grid-template-areas:
      'copy stage'
      'editor stage'
      'editor chapters';
    grid-template-rows: auto 1fr auto;
    column-gap: clamp(24px, 3vw, 48px);
  }
  .hero__copy {
    grid-area: copy;
    padding-top: clamp(16px, 3vw, 48px);
    position: relative;
    z-index: 2;
  }
  .hero h1 {
    font-size: clamp(2rem, 3.2vw, 2.6rem);
  }
  .hero__copy .lede {
    margin-top: 1.25rem;
    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
  }
  .hero__cta {
    margin-top: 1.8rem;
  }
  .hero__stage {
    grid-area: stage;
    width: 100%;
    align-self: start;
  }
  .hero__stage img,
  .hero__stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* the editor floats over the scene like the game's own window */
  .editor {
    grid-area: editor;
    align-self: start;
    position: relative;
    z-index: 3;
    margin-top: 1.8rem;
    margin-right: -16%;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.75);
  }
  .editor__bar {
    min-height: 1.9rem;
    font-size: 0.72rem;
  }
  .editor__bar img {
    width: 16px;
    height: 16px;
    image-rendering: pixelated;
  }
  .editor__file {
    margin-left: auto;
    color: #5a3a1c;
  }
  .editor__body {
    margin-top: var(--px);
    background: var(--code);
  }
  .editor__tools {
    display: flex;
    gap: 6px;
    padding: 6px;
    background: #262626;
  }
  .ebtn {
    font: 400 0.66rem/1 var(--display);
    padding: 0.45em 0.7em 0.4em;
    color: #2a2a2a;
    background: var(--stone);
    box-shadow: inset -2px -2px 0 var(--stone-lo), inset 2px 2px 0 #fff;
  }
  .ebtn--run {
    background: #7cc95a;
    box-shadow: inset -2px -2px 0 #2f6a1d, inset 2px 2px 0 #b9f29c;
    color: #11300a;
    transition: transform 80ms;
  }
  .ebtn--run[data-pressed] {
    transform: translateY(1px);
    box-shadow: inset 2px 2px 0 #2f6a1d, inset -2px -2px 0 #a6e486;
    filter: brightness(0.92);
  }
  .editor__code {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    font: 400 0.74rem/1.6 var(--display);
    padding: 10px 0 12px;
    min-height: calc(9 * 1.6em + 22px);
    --lh: 1.6em;
  }
  .editor__code pre {
    margin: 0;
    font: inherit;
    white-space: pre;
  }
  .editor__gutter {
    color: #5a5a5a;
    text-align: right;
    padding: 0 10px 0 10px;
    user-select: none;
  }
  .editor__text {
    color: #d4d4d4;
    overflow: hidden;
  }
  .editor__text :global(.k) { color: #f0c060; }
  .editor__text :global(.s) { color: #a6e07a; }
  .editor__text :global(.n) { color: #ef9a6a; }
  .editor__text :global(.c) { color: #8f8f8f; }
  .editor__text :global(.f) { color: #dcdcaa; }
  .editor__text :global(.caret) {
    display: inline-block;
    width: 2px;
    height: 1.15em;
    margin-bottom: -0.2em;
    background: var(--brass-hi);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .suggest {
    position: absolute;
    left: calc(1ch + 20px + var(--col) * 1ch);
    top: calc(10px + var(--row) * var(--lh));
    margin: 0;
    padding: 3px;
    list-style: none;
    background: #252526;
    box-shadow: 0 0 0 1px #454545, 0 8px 20px rgb(0 0 0 / 0.5);
    font-size: 0.95em;
    z-index: 2;
  }
  .suggest li {
    padding: 2px 8px;
    color: #c8c8c8;
  }
  .suggest li::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    background: var(--amber);
  }
  .suggest li[data-hit] {
    background: #094771;
    color: #fff;
  }
  .editor__console {
    border-top: 3px solid #000;
    background: #181818;
    padding: 8px 12px 10px;
    font: 400 0.68rem/1.55 var(--display);
    color: #c8c8c8;
    min-height: calc(4 * 1.55em + 18px);
  }
  .editor__label {
    display: block;
    color: #8a8a8a;
    margin-bottom: 2px;
  }
  .editor__console :global(.ran) {
    color: var(--green);
  }

  .chapters {
    grid-area: chapters;
    padding-left: 96px;
    display: flex;
    gap: 14px;
    align-items: stretch;
    margin-top: 18px;
  }
  .play {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    background: var(--stone);
    color: #2a2a2a;
    box-shadow: inset -3px -3px 0 var(--stone-lo), inset 3px 3px 0 #fff, 0 0 0 3px #000;
    margin: 3px;
    cursor: pointer;
    transition: transform 80ms;
  }
  .play:active {
    transform: translateY(2px);
    box-shadow: inset 3px 3px 0 var(--stone-lo), inset -3px -3px 0 #ddd, 0 0 0 3px #000;
  }
  .play svg {
    width: 18px;
    height: 18px;
  }
  .play .i-play,
  .play[data-state='paused'] .i-pause {
    display: none;
  }
  .play[data-state='paused'] .i-play {
    display: block;
  }
  .chapters ol {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chapters button[data-chapter] {
    width: 100%;
    display: grid;
    gap: 8px;
    padding: 0 0 4px;
    border: 0;
    background: none;
    color: var(--ink-3);
    text-align: left;
    font: inherit;
    cursor: pointer;
    transition: color 200ms;
  }
  .chapters button[data-chapter]:hover,
  .chapters button[data-active] {
    color: var(--ink);
  }
  .chapters__bar {
    height: 4px;
    background: #2e271f;
    overflow: hidden;
  }
  .chapters__bar span {
    display: block;
    height: 100%;
    background: var(--brass);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }
  .chapters__title {
    font: 400 0.82rem/1.2 var(--display);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    align-items: center;
  }
  .chapters__title .soon {
    vertical-align: 0;
  }
  .chapters__text {
    font-size: 0.92rem;
    line-height: 1.4;
  }

  @media (max-width: 1180px) {
    .hero__in {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'copy' 'stage' 'chapters' 'editor';
      grid-template-rows: auto;
    }
    .hero__copy {
      max-width: 40rem;
      padding-bottom: 1rem;
    }
    .chapters {
      padding-left: 0;
    }
    .editor {
      margin: 28px 0 0;
      width: min(560px, 100%);
    }
  }
  @media (max-width: 700px) {
    .editor__code {
      font-size: 0.66rem;
    }
    .chapters ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 18px;
    }
    .chapters__text {
      font-size: 0.86rem;
    }
  }
</style>
